# Example server/.env
# Copy this file to server/.env and fill in the values. Do NOT commit your real keys.

# Primary OpenAI API key (used for REST fallback)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Google GenAI API key (if you want to use the Google SDK path)
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Development-only: set to '1' to relax certain Content-Security-Policy headers
DEV_CSP_RELAX=1

# Port for local server (defaults to 8787 if omitted)
PORT=8787